{
  "name": "addison-game",
  "version": "1.0.0",
  "description": "ADDISON \u2014 Compliance Inspector. Vertical slice: Day 1, Bonerville.",
  "scripts": {
    "build": "./build.sh",
    "watch": "./build.sh --watch",
    "validate": "npx esbuild tools/validate.ts --bundle --platform=node --outfile=dist/validate.cjs --loader:.json=json --log-level=warning && node dist/validate.cjs",
    "simulate": "npx esbuild tools/simulate.ts --bundle --platform=node --outfile=dist/simulate.cjs --loader:.json=json --log-level=warning && node dist/simulate.cjs",
    "typecheck": "tsc --noEmit",
    "serve": "python3 -m http.server 8123",
    "ingest": "npx esbuild tools/ingest.ts --bundle --platform=node --outfile=dist/ingest.cjs --loader:.json=json --log-level=warning && node dist/ingest.cjs",
    "map-houses": "npx esbuild tools/map-houses.ts --bundle --platform=node --outfile=dist/map-houses.cjs --loader:.json=json --log-level=warning && node dist/map-houses.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2"
  }
}